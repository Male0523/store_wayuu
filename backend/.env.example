# Copia este archivo como .env y completa los valores privados.
DJANGO_SECRET_KEY=PEGA_AQUI_TU_CLAVE_SECRETA_DE_DJANGO
DJANGO_ENV=development
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# SQLite local explícita (no requiere instalar PostgreSQL).
DB_ENGINE=sqlite

# Para PostgreSQL local, cambia DB_ENGINE a postgresql y define una URL de loopback.
# No copies aquí DATABASE_URL de Render ni una URL de producción.
# DB_ENGINE=postgresql
# DEV_DATABASE_URL=postgresql://wayuu_dev:CAMBIA_ESTA_CLAVE@127.0.0.1:5432/wayuu_dev

# Configuración MySQL local heredada; no se combina con DEV_DATABASE_URL.
# DB_ENGINE=mysql
# DB_NAME=wayuu_db
# DB_USER=wayuu_app
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306

# En Render, DJANGO_ENV=production y DATABASE_URL se inyecta desde wayuuwaa-db.
